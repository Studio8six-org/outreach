# Copy to .env.local (and add the same three values in Vercel -> Settings -> Environment Variables).

# Who can sign in: email:password pairs separated by commas. No commas inside a password.
TEAM_LOGINS=ada@your-agency.com:choose-a-password,bola@your-agency.com:choose-another

# A long random text that signs the login cookie. Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase -> Connect -> "Transaction pooler" link (port 6543). Put your real database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres
